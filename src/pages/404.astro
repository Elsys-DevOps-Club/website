---
import Button from "../components/Button.astro";
import Terminal from "../components/Terminal.astro";
import Layout from "../layouts/Layout.astro";
import { getHome } from "../lib/content";

const { notFound } = await getHome();
---

<Layout
  title={notFound.title}
  description={notFound.text}
  footerGap={36}
  noindex
>
  <div class="w nf">
    <p class="prompt">~/devops $</p>
    <h1>{notFound.title}</h1>
    <p class="lead">{notFound.text}</p>
    <!-- Терминалът е част от шаблона, не от съдържанието. -->
    <Terminal>
      <Fragment slot="command">
        kubectl get page <span id="pn">page</span> -n devops
      </Fragment>
      <p class="err">
        Error from server (NotFound): pages.elsys.club "<span id="pn2">page</span>" not found
      </p>
    </Terminal>
    <div class="go">
      <Button href="/" label={notFound.back} />
    </div>
  </div>
  <!-- Единственият JS на сайта: без него в блока остава "page". -->
  <script is:inline>
    // Адресът се декодира преди филтъра: иначе кирилицата се реже на
    // шестнайсетични остатъци. Невалидна %-последователност хвърля URIError.
    var path = location.pathname;
    try {
      path = decodeURIComponent(path);
    } catch (e) {}
    // Показва се само последният сегмент на адреса.
    // Филтърът е Unicode-aware: \w без флага u би махнал и кирилицата.
    var seg = path.split("/").filter(Boolean).pop() || "";
    var slug = seg.replace(/[^\p{L}\p{N}_-]/gu, "").slice(0, 40);
    var a = document.getElementById("pn");
    var b = document.getElementById("pn2");
    if (slug && a && b) {
      a.textContent = slug;
      b.textContent = slug;
    }
  </script>
</Layout>

<style>
  .nf {
    padding-top: 40px;
  }

  h1 {
    font-size: 40px;
    line-height: 1.05;
    margin: 0 0 16px;
  }

  .lead {
    font-size: 17px;
    margin: 0 0 28px;
    max-width: 40ch;
  }

  .nf > :global(.term) {
    max-width: 720px;
  }

  .err {
    margin: 0;
    color: var(--accent);
    overflow-wrap: anywhere;
  }

  .go {
    margin-top: 32px;
  }

  @media (min-width: 900px) {
    .nf {
      padding-top: 96px;
    }

    h1 {
      font-size: 72px;
    }
  }
</style>
