---
import Button from "../components/Button.astro";
import MeetingAccordion from "../components/MeetingAccordion.astro";
import PageHead from "../components/PageHead.astro";
import Terminal from "../components/Terminal.astro";
import UpcomingCard from "../components/UpcomingCard.astro";
import Layout from "../layouts/Layout.astro";
import { getHome, getMeetingsPage } from "../lib/content";
import { formatDate, formatTime, getMeetings } from "../lib/meetings";

const page = await getMeetingsPage();
const { discordUrl } = await getHome();
const { planned, past } = await getMeetings();

// Етикетът на линка е в [скоби], за да стои целият текст в съдържанието.
const [leadBefore, leadLink, leadAfter] = page.lead.split(/[[\]]/);

const when = (meeting: (typeof planned)[number]) => {
  const { start, room, speaker } = meeting.data;
  return [
    formatDate(start),
    formatTime(meeting),
    room && `${page.roomLabel} ${room}`,
    speaker,
  ]
    .filter(Boolean)
    .join(" · ");
};
---

<Layout title={page.title} description={page.description}>
  <PageHead prompt={page.prompt} title={page.title}>
    <Fragment slot="lead">{leadBefore}<a href={discordUrl}>{leadLink}</a>{leadAfter}</Fragment>
  </PageHead>
  <section class="w end">
    <h2 class="lbl">{page.upcoming}</h2>
    <div class="ups">
      {
        planned.length > 0 ? (
          planned.map((meeting) => (
            <UpcomingCard
              id={meeting.id}
              status={page.plannedStatus}
              title={meeting.data.title}
              meta={when(meeting)}
              cta={page.discordCta}
              href={discordUrl}
            />
          ))
        ) : (
          <Terminal command={page.upcomingCommand}>
            <p class="out">{page.upcomingEmpty}</p>
            <Button slot="action" href={discordUrl} label={page.discordCta} />
          </Terminal>
        )
      }
    </div>
    {
      past.length > 0 && (
        <>
          <h2 class="lbl">{page.past}</h2>
          <MeetingAccordion
            meetings={past}
            command={page.listCommand}
            columns={page.columns}
            describe={page.describeCommand}
            fields={page.fields}
            materialsPrefix={page.materialsPrefix}
          />
        </>
      )
    }
  </section>
</Layout>

<style>
  .lbl {
    margin: 0 0 16px;
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .out {
    margin: 0;
  }

  .ups {
    display: grid;
    gap: 20px;
    margin-bottom: 64px;
  }

  @media (min-width: 900px) {
    .ups {
      margin-bottom: 88px;
    }
  }
</style>
