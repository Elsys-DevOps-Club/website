---
import EventsTable from "../components/EventsTable.astro";
import Hero from "../components/Hero.astro";
import RouteLinks from "../components/RouteLinks.astro";
import Layout from "../layouts/Layout.astro";
import { getHome } from "../lib/content";
import { formatDate, getHomeMeetings, meetingHref } from "../lib/meetings";

const { title, discordUrl, hero, events, routes, footer, school } =
  await getHome();

const site = Astro.site;
const source = footer.links.find((link) => link.key === "source");
const organization = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: title,
  url: new URL("/", site).href,
  logo: new URL("/brand/wordmark-on-light.svg", site).href,
  sameAs: source ? [source.href] : [],
  parentOrganization: {
    "@type": "EducationalOrganization",
    name: school.name,
    url: school.url,
  },
};

const { next, past, hasMore } = await getHomeMeetings();
const rows = [
  next
    ? {
        when: formatDate(next.data.start),
        status: events.pending,
        text: next.data.title,
        href: meetingHref(next),
      }
    : { when: events.soon, status: events.pending, text: events.pendingText },
  ...past.map((meeting) => ({
    when: formatDate(meeting.data.start),
    status: events.completed,
    text: meeting.data.title,
    href: meetingHref(meeting),
    done: true,
  })),
];
---

<Layout>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(organization)} />
  <Hero
    prompt={hero.prompt}
    title={title}
    quote={hero.quote}
    cta={hero.cta}
    more={hero.more}
    discordUrl={discordUrl}
  >
    <EventsTable
      label={events.label}
      command={events.command}
      columns={events.columns}
      rows={rows}
      all={hasMore ? { label: events.all, href: events.allHref } : undefined}
    />
  </Hero>
  <RouteLinks
    label={routes.label}
    items={routes.items}
    discord={{ ...routes.discord, href: discordUrl }}
  />
</Layout>
