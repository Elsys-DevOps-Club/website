---
import Logo from "./Logo.astro";

interface Props {
  email: string;
  contact: string;
  discord: { label: string; href: string };
  links: { key: "source" | "network"; label: string; href: string }[];
  gap: number;
}

const { email, contact, discord, links, gap } = Astro.props;

const svg = {
  width: 20,
  height: 20,
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": 2,
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
  "aria-hidden": "true",
} as const;

// Прости монохромни знаци, без иконков пакет (N1). Discord е контурът на знака му, нарисуван наново.
const icons = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path>',
  discord:
    '<path d="M8.6 4.4C10.8 4 13.2 4 15.4 4.4C16.8 4.8 18 5.3 19.2 6C21.4 9.2 22 12.6 21.6 16.2C20.2 17.3 18.6 18 16.9 18.6L16 17.2C16.6 17 17.2 16.7 17.8 16.4C14.4 17.8 9.6 17.8 6.2 16.4C6.8 16.7 7.4 17 8 17.2L7.1 18.6C5.4 18 3.8 17.3 2.4 16.2C2 12.6 2.6 9.2 4.8 6C6 5.3 7.2 4.8 8.6 4.4Z"></path><ellipse cx="8.9" cy="12" rx="1.3" ry="1.6" fill="currentColor" stroke="none"></ellipse><ellipse cx="15.1" cy="12" rx="1.3" ry="1.6" fill="currentColor" stroke="none"></ellipse>',
  source: '<path d="M7 8l-4 4 4 4M17 8l4 4-4 4M14 5l-4 14"></path>',
  network:
    '<circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"></path>',
};
---

<footer class="f" style={`margin-top: ${gap}px`}>
  <div class="w fg">
    <div class="fl">
      <Logo />
    </div>
    <p class="exit"><span>~/devops $</span> exit 0</p>
    <ul class="fd">
      <li>
        <svg {...svg} set:html={icons.mail} />
        <a href={`mailto:${email}`} title={email} aria-label={email}>{contact}</a>
      </li>
      <li>
        <svg {...svg} set:html={icons.discord} />
        <a href={discord.href}>{discord.label}</a>
      </li>
      {
        links.map((link) => (
          <li>
            <svg {...svg} set:html={icons[link.key]} />
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .f {
    border-top: 1px solid var(--line);
  }

  /*
    От 900 px логото е широко колкото редът exit 0. Той е моноширинен (JetBrains Mono,
    0.6 em на знак), 17 знака: «~/devops $ exit 0». При 16 px това са 163,2 px.
    Смяна на --exit-fs, на текста или на шрифта сменя и логото; текстът и
    шрифтът изискват ръчна проверка. Под 120 px (минимум по бранд насоките)
    логото не слиза.
  */
  .fg {
    --exit-fs: 16px;
    --exit-chars: 17;
    --exit-w: calc(var(--exit-chars) * 0.6 * var(--exit-fs));
    display: grid;
    gap: 16px;
    padding-top: 24px;
    padding-bottom: max(16px, env(safe-area-inset-bottom));
  }

  /*
    На телефон логото е 120 px (минимумът по бранд насоките) и НЕ следва реда
    exit 0: 120 + 163,2 се събират един до друг. Връзката с --exit-w е само от 900 px.
  */
  .fg {
    --logo-w: 120px;
  }

  .fd {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 13px;
  }

  .fd li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 0;
  }

  /* Крайните редове без външен отстъп: той е отстъпът на футъра. */
  .fd li:first-child {
    padding-top: 0;
  }

  .fd li:last-child {
    padding-bottom: 0;
  }

  /* Иконката следва размера на текста: 20 px при 15 px, сега 17,3 px при 13 px. */
  .fd svg {
    flex: none;
    width: 1.333em;
    height: 1.333em;
    margin-top: 0.133em;
    color: var(--muted);
  }

  /* Връзките са в цвета на иконите. */
  .fd a {
    color: var(--muted);
    text-decoration: none;
  }

  .exit {
    margin: 0;
    font-size: var(--exit-fs);
    color: var(--muted);
  }

  .exit span {
    color: var(--accent);
  }

  /* От 900 px: логото и exit 0 са вляво, линковете вдясно. */
  @media (min-width: 900px) {
    .fg {
      --logo-w: max(120px, var(--exit-w));
      grid-template-columns: max-content minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: 48px;
      row-gap: 12px;
      padding-top: 32px;
      padding-bottom: 16px;
    }

    .fl {
      grid-column: 1;
      grid-row: 1;
    }

    .fd {
      grid-column: 2;
      grid-row: 1 / 3;
    }

    .exit {
      grid-column: 1;
      grid-row: 2;
    }
  }

  /*
    От 360 px до 899 px exit 0 е вдясно от логото, изравнен надясно: десният му
    ръб е на същото разстояние от края на екрана, както левият на логото, с вертикален център върху
    центъра на логото, а линковете са под тях. Под 360 px (280 px съдържание при
    320) 120 + 16 + 163,2 не се събират и exit 0 остава под логото.
    Центърът на логото е центърът на знака, не на изображението: знакът е от
    22,5 до 186,5 от 200, т.е. средата му е на 104,5 (на 4,5 / 200 под средата на
    изображението, ~1 px при 120 px). Центърът на реда exit 0 е върху средата на
    главните (0,367 em над базовата линия) с точност под 0,1 px.
  */
  @media (min-width: 360px) and (max-width: 899px) {
    .fg {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .fl {
      grid-column: 1;
      grid-row: 1;
    }

    .exit {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
      justify-self: end;
      position: relative;
      top: calc(var(--logo-w) * 200 / 505 * 4.5 / 200);
    }

    .fd {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  /* Над 360 px линковете са на два реда по два в равни колони. */
  @media (min-width: 361px) {
    .fd {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 8px;
      row-gap: 20px;
    }

    .fd li {
      padding: 0;
    }
  }

  /* На 361 px колоната е ~157 px и «Свържи се с нас» иска ~154: разстоянието се свива, не шрифтът. */
  @media (min-width: 400px) {
    .fd {
      column-gap: 16px;
    }
  }

  /*
    От 900 px линковете са вляво, центрирани по височина спрямо целия ляв блок
    (лого + exit 0). Шрифтът е 16 px, колкото основния текст; иконките следват
    (1.333em). Това не засяга логото: то следва само реда exit 0 (--exit-fs).
    До 1059 px четирите не се събират на един ред (при 16 px са нужни ~1025 px
    ширина на страницата плюс запас за лента за скрол): две колони по два реда,
    наредени вляво. Flex с wrap би дал 3 + 1.
  */
  @media (min-width: 900px) {
    .fd {
      grid-template-columns: repeat(2, max-content);
      column-gap: 40px;
      align-self: center;
      font-size: 16px;
    }
  }

  /* От 1060 px на един ред, flex с gap; ако текстът порасне, се пренася. */
  @media (min-width: 1060px) {
    .fd {
      display: flex;
      flex-wrap: wrap;
      gap: 20px 40px;
    }
  }
</style>
