---
import { Image } from "astro:assets";
import { render } from "astro:content";
import {
  formatDate,
  formatTime,
  type Meeting,
  materialsLabel,
} from "../lib/meetings";
import Chevron from "./Chevron.astro";

interface Props {
  meetings: Meeting[];
  command: string;
  columns: string[];
  describe: string;
  fields: {
    time: string;
    room: string;
    speaker: string;
    materials: string;
  };
  materialsPrefix: string;
  onlineRoom: string;
}

const {
  meetings,
  command,
  columns,
  describe,
  fields,
  materialsPrefix,
  onlineRoom,
} = Astro.props;

// Тялото на файла е по избор: без него няма нито обвивка, нито отстъп.
const entries = await Promise.all(
  meetings.map(async (meeting) => ({
    meeting,
    Content: meeting.body?.trim() ? (await render(meeting)).Content : undefined,
  })),
);
---

<p class="cmd"><b>$</b> {command}</p>
<div class="head">
  {columns.map((column) => <span>{column}</span>)}
</div>
<div class="log">
  {
    entries.map(({ meeting, Content }, i) => {
      const {
        start,
        title,
        speaker,
        room,
        materials,
        image,
        imageCaption,
      } = meeting.data;
      const rows = [
        { label: fields.time, value: formatTime(meeting) },
        { label: fields.room, value: room ?? onlineRoom },
        { label: fields.speaker, value: speaker },
      ].filter((row) => row.value);
      return (
        <details class="m" id={meeting.id} open={i === 0}>
          <summary>
            <time class="d" datetime={start.toISOString()}>
              {formatDate(start)}
            </time>
            <h3 class="t">{title}</h3>
            <span class="x"><Chevron /></span>
          </summary>
          <div class="body">
            <div class:list={["top", { framed: image }]}>
              <div>
                <p class="cmd"><b>$</b> {describe} {meeting.id}</p>
                <dl>
                  {rows.map((row) => (
                    <>
                      <dt>{row.label}:</dt>
                      <dd>{row.value}</dd>
                    </>
                  ))}
                  {materials && (
                    <>
                      <dt>{fields.materials}:</dt>
                      <dd>
                        <a href={materials}>
                          {materialsLabel(materials, materialsPrefix)}
                        </a>
                      </dd>
                    </>
                  )}
                </dl>
              </div>
              {image && (
                <figure>
                  <Image src={image} alt="" width={800} height={450} />
                  {imageCaption && <figcaption>{imageCaption}</figcaption>}
                </figure>
              )}
            </div>
            {Content && (
              <div class="prose">
                <Content />
              </div>
            )}
          </div>
        </details>
      );
    })
  }
</div>

<style>
  .cmd {
    margin: 0 0 8px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .cmd b {
    color: var(--accent);
    font-weight: 500;
  }

  .head {
    display: none;
  }

  .log {
    border-top: 1px solid var(--line);
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px 16px;
    align-items: baseline;
    padding: 22px 0;
    min-height: 48px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .d {
    grid-column: 1;
    font-size: 14px;
    color: var(--muted);
  }

  .t {
    grid-column: 1;
    margin: 0;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .x {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    display: flex;
  }

  .body {
    padding: 0 0 28px;
  }

  .top:not(.framed),
  .prose {
    max-width: 62ch;
  }

  .prose {
    margin-top: 20px;
    color: var(--fg);
  }

  .prose :global(p) {
    margin: 0 0 12px;
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .body .cmd {
    margin-bottom: 16px;
  }

  figure {
    margin: 20px 0 0;
  }

  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 8px;
  }

  figcaption {
    margin-top: 8px;
    color: var(--muted);
    font-size: 13px;
  }

  dl {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 6px 16px;
    margin: 0;
    font-size: 15px;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  dd a {
    font-weight: 700;
  }

  @media (min-width: 900px) {
    .head {
      display: grid;
      grid-template-columns: 150px minmax(0, 1fr);
      gap: 0;
      padding-bottom: 12px;
      color: var(--muted);
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    summary {
      grid-template-columns: 150px minmax(0, 1fr) auto;
      padding: 28px 0;
    }

    .d {
      grid-column: 1;
      grid-row: 1;
    }

    .t {
      grid-column: 2;
      grid-row: 1;
      font-size: 32px;
    }

    .x {
      grid-column: 3;
      grid-row: 1;
    }

    .body {
      margin-left: 166px;
      padding-bottom: 36px;
    }

    .top.framed {
      display: grid;
      grid-template-columns: minmax(0, 62ch) minmax(0, 1fr);
      gap: 0 40px;
    }

    .framed figure {
      margin: 0;
      max-width: 420px;
    }
  }
</style>
