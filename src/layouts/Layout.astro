---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { getHome } from "../lib/content";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  footerGap?: number;
  noindex?: boolean;
}

const home = await getHome();
const { footer, nav } = home;
const {
  title: pageTitle,
  description = home.description,
  footerGap = 48,
  noindex = false,
} = Astro.props;
const title = pageTitle ? `${pageTitle} · ${home.title}` : home.title;
const ogTitle = pageTitle ?? home.title;

const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(
  "/brand/social/banner-social-preview-1200x630.png",
  Astro.site,
);
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" />

    <link rel="stylesheet" href="/brand/colors.css" />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={home.siteName} />
    <meta property="og:locale" content="bg_BG" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={home.ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <slot name="head" />
  </head>
  <body>
    <div class="p">
      <a class="skip-link" href="#main">{home.skipLink}</a>
      <Header
        label={nav.label}
        menuLabel={nav.menuLabel}
        links={nav.links}
        discord={{ label: nav.discord, href: home.discordUrl }}
      />
      <main id="main"><slot /></main>
      <Footer
        email={footer.email}
        contact={footer.contact}
        discord={{ label: footer.discord, href: home.discordUrl }}
        links={footer.links}
        gap={footerGap}
      />
    </div>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 8px;
    top: 8px;
    padding: 8px 16px;
    background: var(--blue);
    color: var(--on-blue);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }
</style>
